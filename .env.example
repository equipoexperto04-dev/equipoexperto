# ────────────────────────────────────────────────────────────
# SHARED CONFIGURATION (Frontend + Backend)
# ────────────────────────────────────────────────────────────
VITE_API_URL=https://api.equipoexperto.com
# Optional: at vite build, replaces https://equipoexperto.com in index.html (canonical, GA proxy paths). Omit to leave defaults.
# VITE_PUBLIC_SITE_URL=https://equipoexperto.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional: force sign-in redirect_uri to match Google Console (www vs non-www, localhost vs 127.0.0.1).
# If unset, the app uses {current_origin}/oauth/google-return — add that exact URL in Google Cloud Console.
# VITE_GOOGLE_OAUTH_REDIRECT_URI=https://equipoexperto.com/oauth/google-return

# Firebase Web SDK (public client config — safe for Vite bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
FIREBASE_PROJECT_ID=
VITE_USE_FIREBASE_EMAIL_PASSWORD=false
VITE_REQUIRE_EMAIL_VERIFICATION=false

# Sanity (public read — safe for Vite bundle). Create project at https://www.sanity.io/manage
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01


# ────────────────────────────────────────────────────────────
# BACKEND ONLY CONFIGURATION
# ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require

# JWT Secrets - CHANGE THESE IMMEDIATELY IN PRODUCTION
JWT_SECRET=generate-a-256-bit-secret-here-minimum-32-chars-long
JWT_EXPIRES_IN=7d

# Sliding JWT: when remaining lifetime is below this many seconds, server issues a new token (X-New-Access-Token). Default 172800 (48h). Min 300, max 14d.
JWT_RENEW_IF_EXPIRES_WITHIN_SECONDS=172800

# Translation editor — comma-separated user UUIDs (empty = any authenticated user).
TRANSLATION_EDITOR_USER_IDS=00000000-0000-0000-0000-000000000001,00000000-0000-0000-0000-000000000002

# Follow-up cron — stuck processing recovery (minutes, server clamps 15–1440).
FOLLOWUP_STUCK_PROCESSING_MINUTES=45

# Cookie Secret for signed cookies
COOKIE_SECRET=generate-another-256-bit-secret-here-minimum-32-chars

# Public site URL (links, QR codes, OAuth redirects). Required for production.
FRONTEND_URL=https://equipoexperto.com

# Stripe (EUR subscriptions) — https://dashboard.stripe.com
# 1) Create three recurring Prices (Starter €39, Growth €69, Pro €119/mo) — leave trial empty in Stripe; app adds 30-day trial at checkout.
# Optional: STRIPE_TRIAL_DAYS=30 (0 = charge immediately)
# 2) Webhook endpoint (production): https://api.equipoexperto.com/api/webhooks/stripe
#    Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
# 3) Enable Customer Portal in Stripe → Settings → Billing → Customer portal
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_TRIAL_DAYS=30

# Extra allowed browser origins (optional). Always merged with built-in defaults in server/src/utils/corsWhitelist.js:
# equipoexperto.com, www., montseaumateii.pages.dev, www.montseaumate.com + FRONTEND_URL.
CORS_ORIGINS=

# Email Configuration (server-side Gmail SMTP — OTP verification, forgot-password, landing contact only).
# Workspace outbound mail (leads, follow-ups, reports) uses each user's Integrations → Google OAuth, Microsoft, or SMTP — not these vars.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# CDMON SMTP — Landing Page Contact Form
SUPPORT_SMTP_HOST=mail.cdmon.com
SUPPORT_SMTP_PORT=465
SUPPORT_SMTP_SECURE=true
SUPPORT_SMTP_USER=info@yourdomain.com
SUPPORT_SMTP_PASS=your-smtp-password
SUPPORT_EMAIL=info@yourdomain.com

# Google OAuth Integration (same Web client as VITE_GOOGLE_CLIENT_ID is typical)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Google Cloud Console → OAuth Web client → Authorized redirect URIs needs TWO different paths (not interchangeable):
#   A) Sign-in / Register “Continue with Google” → {each frontend origin}/oauth/google-return
#      e.g. https://equipoexperto.com/oauth/google-return, https://www.equipoexperto.com/oauth/google-return,
#      https://YOUR_PAGES_SUBDOMAIN.pages.dev/oauth/google-return, plus localhost dev URLs if needed.
#   B) Dashboard → Integrations → Gmail connect → {BACKEND_URL}/api/integrations/google/callback
# Listing only (B) breaks (A) with Error 400 redirect_uri_mismatch.

# Microsoft OAuth Integration
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Public API base URL (OAuth callbacks must match Google/Microsoft exactly). Required for integrations.
BACKEND_URL=https://api.equipoexperto.com

# Apify — Marketplace scraping with contact info
APIFY_API_TOKEN=your-apify-api-token-here

# Marketplace “Get leads” run credits per UTC month (optional overrides; defaults: Basic 15, Growth 45, Pro 100, Enterprise 500)
# Free trial users get 0 until they subscribe (trial_ends_at cleared on plan upgrade).
MARKETPLACE_RUNS_BASIC=15
MARKETPLACE_RUNS_GROWTH=45
MARKETPLACE_RUNS_PRO=100
MARKETPLACE_RUNS_ENTERPRISE=500

# Max simultaneous digital employees (review + lead capture + follow-up) per plan
MARKETPLACE_MAX_EMPLOYEES_BASIC=1
MARKETPLACE_MAX_EMPLOYEES_GROWTH=2
MARKETPLACE_MAX_EMPLOYEES_PRO=3
MARKETPLACE_MAX_EMPLOYEES_ENTERPRISE=99

# Apify actor IDs — override if you switch to a different actor on Apify Store
# Verify / find latest actors at: https://apify.com/store
# Defaults verified April 2026
APIFY_ACTOR_IDEALISTA=crawlerbros/idealista-scraper
APIFY_ACTOR_FOTOCASA=gio21/fotocasa-scraper
APIFY_ACTOR_PISOS=gio21/pisos-scraper
APIFY_ACTOR_COCHES=ivanvs/coches-net-scraper
APIFY_ACTOR_AUTOSCOUT=ivanvs/autoscout-scraper
APIFY_ACTOR_INFOJOBS=crawlerbros/infojobs-scraper
APIFY_ACTOR_WALLAPOP=igolaizola/wallapop-scraper
APIFY_ACTOR_VINTED=automation-lab/vinted-scraper
